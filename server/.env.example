# Example environment configuration file for the server application.
# Rename this file to .env and fill in the appropriate values before running the server.

# Server configuration, the port on which the server will listen
PORT=your-server-port-here

# Database configuration, MySQL connection details
MYSQL_HOST=your-mysql-host-here
MYSQL_USER=your-mysql-username-here
MYSQL_PASSWORD=your-mysql-password-here
MYSQL_DATABASE=your-mysql-database-name-here

# AI Valuation Configuration, OPENAI API Key
OPENAI_API_KEY=your-openai-api-key-here

# Telegram Bot Configuration
TON_API_MAINNET_URL=https://toncenter.com/api/v2/jsonRPC
TON_API_TESTNET_URL=https://testnet.toncenter.com/api/v2/jsonRPC
TON_API_KEY=your-ton-api-key-here

# TON Wallet Configuration
TON_MNEMONIC=your-ton-wallet-mnemonic-phrase-here
STORE_WALLET_ADDRESS=your-store-wallet-address-here
CONTRACT_ADDRESS=your-contract-address-here

# IG Markets Configuration (live or demo)
IG_BASE_URL=https://api.ig.com/gateway/deal
IG_FALLBACK_BASE_URL=https://demo-api.ig.com/gateway/deal
IG_API_KEY=your-ig-api-key-here
IG_USERNAME=your-ig-username-here
IG_PASSWORD=your-ig-password-here
IG_GOLD_EPIC=CS.D.USCGC.TODAY.IP
# USD/INR epic for INR conversion (AED is fixed at 3.67)
IG_USDINR_EPIC=CS.D.USDINR.TODAY.IP
# Serve stale weekend/off-market quotes from last successful cache (hours)
IG_STALE_CACHE_MAX_AGE_HOURS=120
# Optional custom file for persisted XAU cache
IG_STALE_CACHE_FILE=./cache/ig-xau-cache.json
# GoldAPI fallback (used when IG markets are unavailable)
GOLDAPI_BASE_URL=https://www.goldapi.io/api
GOLDAPI_ACCESS_TOKEN=your-goldapi-access-token-here

# opBNB Valuation Registry (testnet)
OPBNB_RPC_URL=https://opbnb-testnet-rpc.bnbchain.org
OPBNB_PRIVATE_KEY=your-opbnb-private-key
OPBNB_VALUATION_OWNER=0xyour-owner-address-optional
OPBNB_VALUATION_REGISTRY_ADDRESS=0xyour-deployed-registry-address

# AVAX C-Chain Valuation Registry (Fuji testnet by default)
AVAX_CCHAIN_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVAX_PRIVATE_KEY=your-avax-private-key
AVAX_VALUATION_OWNER=0xyour-owner-address-optional
AVAX_VALUATION_REGISTRY_ADDRESS=0xyour-avax-valuation-registry-address

# NFT issuance worker (backend queue processor)
NFT_ISSUANCE_RPC_URL=https://opbnb-testnet-rpc.bnbchain.org
NFT_ISSUANCE_PRIVATE_KEY=your-nft-issuer-private-key
NFT_ISSUANCE_CONTRACT_ADDRESS=0xyour-erc721-contract-address
NFT_ISSUANCE_MINT_METHODS=safeMint,mint,mintTo
NFT_ISSUANCE_POLL_MS=15000
NFT_ISSUANCE_BATCH_SIZE=5
NFT_ISSUANCE_MAX_RETRIES=3
NFT_ISSUANCE_CLAIM_STALE_MS=180000
NFT_ISSUANCE_RUN_ONCE=false
AVAX_NFT_ISSUANCE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
NFT_ISSUANCE_PRIVATE_KEY_AVAX=your-avax-nft-issuer-private-key
NFT_ISSUANCE_CONTRACT_ADDRESS_AVAX=0xyour-avax-erc721-contract-address

# ERC-721 deployment settings
NFT_ERC721_NAME=Dhahaby Asset NFT
NFT_ERC721_SYMBOL=DHABY
NFT_ERC721_OWNER=0xyour-owner-address-optional
OPBNB_NFT_CONTRACT_ADDRESS=0xyour-erc721-contract-address
AVAX_NFT_CONTRACT_ADDRESS=0xyour-avax-erc721-contract-address

# Firebase token verification (no service account required)
FIREBASE_PROJECT_ID=dhahaby-hub

# Comma-separated Dhahaby admin emails allowed to review appraiser submissions
APPRAISER_ADMIN_EMAILS=

# Transactions email OTP lookup
TRANSACTION_EMAIL_OTP_SECRET=change-me
TRANSACTION_EMAIL_OTP_TTL_MINUTES=10
TRANSACTION_EMAIL_OTP_MIN_RESEND_SECONDS=60
TRANSACTION_EMAIL_OTP_DAILY_LIMIT=10
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@dhahaby.com
